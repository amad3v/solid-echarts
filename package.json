{
  "name": "@amad3v/solid-echarts",
  "version": "1.2.0",
  "description": "A SolidJS wrapper for Apache ECharts.",
  "homepage": "https://codeberg.org/amad3v/solid-echarts",
  "bugs": {
    "url": "https://codeberg.org/amad3v/solid-echarts/issues"
  },
  "license": "MIT",
  "author": "amad3v <amad3v@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/amad3v/solid-echarts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "chk:fix": "pnpm fmt && pnpm lint:fix",
    "dev": "tsdown --watch",
    "fmt": "oxfmt && dprint fmt",
    "fmt:check": "oxfmt --check && dprint check",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "vitest",
    "test:v8": "vitest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "libdocs": "typedoc --favicon ./assets/logo.svg"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "bumpp": "^12.3.0",
    "istanbul-reporter-html-dark": "^1.0.1",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rolldown-plugin-solid": "^0.2.1",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.18",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "echarts": "^6.1.0",
    "solid-js": "^1.9.15"
  }
}
